<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_fullname" model="ir.ui.view">
        <field name="name">crm.lead.form.fullname</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Add First Name / Last Name after the contact (partner_id) in opportunities -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                <field name="partner_first_name"/>
                <field name="partner_last_name"/>
            </xpath>
        </field>
    </record>
</odoo>
