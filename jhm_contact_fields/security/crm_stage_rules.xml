<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        CRM Stage company-isolation rule.

        Stages visible to a user are those where:
          - company_id is not set  (shared / legacy stage — visible to everyone)
          - OR company_id is one of the companies the user belongs to

        This rule filters the stage_id Many2one dropdown in form/list views.
        The _read_group_stage_ids override in crm_lead.py handles the Kanban
        columns and the status bar (both use sudo so ir.rules are bypassed there).
    -->
    <record id="crm_stage_per_company_rule" model="ir.rule">
        <field name="name">CRM Stage: visible only to own company</field>
        <field name="model_id" ref="crm.model_crm_stage"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
