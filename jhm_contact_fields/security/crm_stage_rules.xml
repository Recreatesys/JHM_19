<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        CRM Stage company-isolation rule.

        Stages visible to a user are those where company_id matches the
        user's current company.  Stages with company_id not set are hidden
        (every stage MUST have a company assigned for proper isolation).

        This rule filters the stage_id Many2one dropdown in form/list views.
        The _read_group_stage_ids override in crm_lead.py handles the Kanban
        columns and the status bar (both use sudo so ir.rules are bypassed there).
    -->
    <record id="crm_stage_per_company_rule" model="ir.rule">
        <field name="name">CRM Stage: visible only to own company</field>
        <field name="model_id" ref="crm.model_crm_stage"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', '=', user.company_id.id)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
