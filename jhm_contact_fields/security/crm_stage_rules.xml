<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        CRM Stage company-isolation rule.

        Write/create/unlink restricted to stages matching the user's
        current company.  Read is unrestricted so that sorting, list
        views, and reports can display stages from other companies.

        The Kanban pipeline columns are filtered by _read_group_stage_ids
        in crm_lead.py (uses sudo, bypasses ir.rules anyway).
        The stage_id dropdown in forms uses domain="..." on the field.
    -->
    <record id="crm_stage_per_company_rule" model="ir.rule">
        <field name="name">CRM Stage: write only own company</field>
        <field name="model_id" ref="crm.model_crm_stage"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="perm_read"   eval="False"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
