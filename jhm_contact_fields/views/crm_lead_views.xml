<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_jhm_fields" model="ir.ui.view">
        <field name="name">crm.lead.form.jhm.fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Restrict stage_id dropdown/statusbar to current company -->
            <xpath expr="//field[@name='stage_id'][@widget='rotting_statusbar_duration']" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id)]</attribute>
            </xpath>

            <!-- Documents smart button -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object"
                        name="action_open_jhm_documents"
                        class="oe_stat_button"
                        icon="fa-file"
                        invisible="jhm_documents_count == 0">
                    <field name="jhm_documents_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>

            <!-- Sync Contact button — shown when no contact is linked -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object"
                        name="action_open_contact_sync_wizard"
                        class="oe_stat_button"
                        icon="fa-user-plus"
                        string="Sync Contact"
                        invisible="partner_id != False"/>
            </xpath>

            <!-- Fields in the Contacts tab (appended after the base groups) -->
            <xpath expr="//page[@name='lead']" position="inside">
                <group string="Personal">
                    <field name="partner_birthday" string="Birthday"/>
                </group>
                <group string="Spouse &amp; Children">
                    <group>
                        <field name="partner_spouse_highest_qualification" string="Spouse's Highest Qualification"/>
                        <field name="partner_spouse_occupation"        string="Spouse's Occupation"/>
                    </group>
                    <group>
                        <field name="partner_child_1"                  string="Applicant Child 1"/>
                        <field name="partner_child_2"                  string="Applicant Child 2"/>
                        <field name="partner_child_3"                  string="Applicant Child 3"/>
                        <field name="partner_child_4"                  string="Applicant Child 4"/>
                    </group>
                </group>
                <group string="Case Tracking">
                    <group>
                        <field name="partner_nomination"          string="Nomination"/>
                        <field name="partner_nomination_due_date" string="Nomination Due Date"/>
                        <field name="partner_eoi"                 string="EOI"/>
                        <field name="partner_eoi_date"            string="EOI Date"/>
                        <field name="partner_los_date"            string="LOS Date"/>
                        <field name="partner_lodgment_date"       string="Lodgment Date"/>
                        <field name="partner_ielts"               string="IELTS"/>
                        <field name="partner_ielts_due_date"      string="IELTS Due Date"/>
                        <field name="partner_aus_skill_status"    string="Aus Skill Status"/>
                        <field name="partner_assessment"          string="Assessment"/>
                        <field name="partner_assessment_due_date" string="Assessment Due Date"/>
                    </group>
                    <group>
                        <field name="partner_health"          string="Health"/>
                        <field name="partner_health_due_date" string="Health Due Date"/>
                        <field name="partner_police"          string="Police"/>
                        <field name="partner_police_due_date" string="Police Due Date"/>
                    </group>
                </group>
                <group string="Admin">
                    <field name="partner_admin" nolabel="1"
                           placeholder="Admin notes..."
                           style="font-family:monospace; white-space:pre-wrap;"/>
                </group>
            </xpath>

            <!-- Replace free-text probability input with selection field -->
            <!-- Hide the original float input and % sign -->
            <xpath expr="//div[@id='probability']/field[@name='probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@id='probability']/span" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Insert selection field inside the same div -->
            <xpath expr="//div[@id='probability']/field[@name='probability']" position="before">
                <field name="jhm_probability"
                       class="oe_inline"
                       readonly="won_status != 'pending'"/>
            </xpath>

            <!-- Hide AI-calculated probability (icon, tooltip, ~XX%) -->
            <xpath expr="//a[@name='action_set_automated_probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//widget[@name='pls_tooltip_button']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='automated_probability']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- HK only: replace single "New Quotation" with two buttons -->
            <!-- Hide original button for HK company -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">company_id == 1 or type == 'lead' or (probability == 0 and not active)</attribute>
            </xpath>
            <!-- Add two new buttons for HK company -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="after">
                <button string="New Quote in JHML"
                        name="action_sale_quotations_new" type="object"
                        class="oe_highlight" data-hotkey="l"
                        title="Create quotation in John Hu Migration Consulting Ltd."
                        invisible="company_id != 1 or type == 'lead' or (probability == 0 and not active)"/>
                <button string="New Quote in JHM"
                        name="action_sale_quotations_new_jhm" type="object"
                        class="oe_highlight" data-hotkey="j"
                        title="Create quotation in John Hu Migration Consulting"
                        invisible="company_id != 1 or type == 'lead' or (probability == 0 and not active)"/>
            </xpath>

            <!-- Fix email_from label — base view hardcodes string="Email", override to correct label -->
            <xpath expr="//field[@name='email_from'][@widget='email']" position="attributes">
                <attribute name="string">Main Applicant Email</attribute>
            </xpath>

            <!-- Co-owner, Inactive Lead — after user_id in opportunity group -->
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='user_id']" position="after">
                <field name="co_owner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="time_to_close"/>
            </xpath>

            <!-- Fields after Main Applicant Phone in the opportunity contact group -->
            <xpath expr="//group[@name='opportunity_partner']//div[field[@name='phone']]" position="after">
                <field name="partner_occupation"               string="Occupation"/>
                <field name="partner_gender"                   string="Gender"/>
                <field name="partner_client_nationality_id"    string="Nationality"/>
                <field name="partner_jhm_line_id"              string="Line ID"/>
                <field name="partner_communication_channel_id" string="Channel"/>
                <field name="partner_wechat"                   string="WeChat"/>
                <field name="partner_b2b_engagement"           string="B2B"/>
                <field name="partner_background_id"            string="Background"/>
                <field name="partner_spouse_name"              string="Spouse Name"/>
                <field name="partner_spouse_phone"             string="Spouse Phone"/>
                <field name="partner_spouse_email"             string="Spouse Email"/>
                <field name="partner_immigration_country"      string="Immigration Country"/>
                <field name="partner_visa_program_id"          string="Visa Program" options="{'no_create': False, 'no_open': False}"/>
                <field name="partner_previous_visa_program_id" string="Prev. Visa Program" options="{'no_create': False, 'no_open': False}"/>
                <field name="partner_jhm_lead_source_id"       string="Lead Source"/>
                <field name="partner_source_details"           string="Source Details"/>
                <field name="webinar_name"                     string="Webinar Name" invisible="company_id == 1"/>
                <field name="partner_migration_budget"         string="Migration Budget"/>
            </xpath>

            <!-- Remaining fields after Tags in the opportunity group -->
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='tag_ids']" position="after">
                <field name="jhm_entity"                   string="JHM/JHML" invisible="company_id != 1"/>
                <field name="partner_commission"            string="Commission"/>
                <field name="partner_facing_problems"       string="Facing Problems"/>
                <field name="partner_consultation_fee_paid" string="Fee Paid"/>
                <field name="create_date"                   string="Creation Date" readonly="1"/>
                <field name="partner_appointment_date"      string="Appointment Date"/>
                <field name="partner_appointment_date_2"   string="2nd Appointment Date" invisible="company_id == 1"/>
                <field name="partner_appointment_notes"     string="Appointment Notes"/>
                <field name="partner_last_call_date"        string="Last Call Date"/>
                <field name="partner_sf_followup_date"      string="Followup Date"/>
                <field name="partner_chat_log"              string="Chat Log"    placeholder="Chat log..."/>
                <field name="partner_jhm_description"       string="Description" placeholder="Description..."/>
            </xpath>

            <!-- Sales tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Sales" name="jhm_sales" invisible="type == 'lead'">
                    <group string="Process Team">
                        <group>
                            <field name="process_team_ids" widget="many2many_tags" string="Process Team in Charge" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="process_2_ids" widget="many2many_tags" string="Process 2" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Order">
                        <group>
                            <field name="sale_total_amount"     string="Total Amount"/>
                            <field name="sale_order_issue_date" string="Order Issue Date"/>
                            <field name="sale_referral"         string="Referral"/>
                        </group>
                        <group>
                            <field name="sale_balance"
                                   string="Balance"
                                   readonly="1"
                                   force_save="1"/>
                            <field name="sale_current_month_total_close"
                                   string="Current Month Total Close"
                                   readonly="1"/>
                            <field name="sale_current_month_total_commission"
                                   string="Current Month Total Commission"
                                   readonly="1"/>
                        </group>
                    </group>

                    <separator string="Admin Notes"/>
                    <field name="partner_admin" nolabel="1" placeholder="Admin notes..."
                           style="font-family:monospace; white-space:pre-wrap;"/>

                    <group string="Payments">
                        <group>
                            <field name="sale_payment_1"      string="1st Payment"/>
                            <field name="sale_payment_date_1" string="1st Payment Date"/>
                            <field name="sale_payment_2"      string="2nd Payment"/>
                            <field name="sale_payment_date_2" string="2nd Payment Date"/>
                            <field name="sale_payment_3"      string="3rd Payment"/>
                            <field name="sale_payment_date_3" string="3rd Payment Date"/>
                            <field name="sale_payment_4"      string="4th Payment"/>
                            <field name="sale_payment_date_4" string="4th Payment Date"/>
                            <field name="sale_payment_5"      string="5th Payment"/>
                            <field name="sale_payment_date_5" string="5th Payment Date"/>
                        </group>
                        <group>
                            <field name="sale_commission_ratio" string="Commission Ratio (%)"/>
                            <field name="sale_commission_1" string="1st Payment Commission" readonly="1" force_save="1"/>
                            <field name="sale_commission_2" string="2nd Payment Commission" readonly="1" force_save="1"/>
                            <field name="sale_commission_3" string="3rd Payment Commission" readonly="1" force_save="1"/>
                            <field name="sale_commission_4" string="4th Payment Commission" readonly="1" force_save="1"/>
                            <field name="sale_commission_5" string="5th Payment Commission" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ── Forecast pivot: add Subtotal measure ─────────────────────────── -->
    <record id="crm_lead_view_forecast_subtotal" model="ir.ui.view">
        <field name="name">crm.lead.forecast.subtotal</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_pivot_forecast"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='prorated_revenue']" position="after">
                <field name="expected_revenue" type="measure"/>
                <field name="forecast_row_total" type="measure"/>
            </xpath>
        </field>
    </record>

    <!-- ── Server action: batch create document folders for opportunities ── -->
    <record id="action_crm_lead_create_document_folders" model="ir.actions.server">
        <field name="name">Create Document Folders</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_create_document_folders()</field>
    </record>

    <!-- ── Quick-create opportunity form ────────────────────────────────── -->
    <record id="jhm_quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.jhm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <!-- Remove Company row -->
            <xpath expr="//div[field[@name='commercial_partner_id']]" position="replace"/>
            <!-- Remove Email row -->
            <xpath expr="//div[field[@name='email_from']]" position="replace"/>
            <!-- Remove Expected Revenue row -->
            <xpath expr="//div[div[field[@name='expected_revenue']]]" position="replace"/>

            <!-- Make name field read-only hint (auto-generated) -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">Auto-generated from name + visa + country</attribute>
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- After phone, add Immigration Country, Visa Program, Communication Channel -->
            <xpath expr="//div[field[@name='phone']]" position="after">
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-globe" title="Immigration Country"/>
                    <field name="partner_immigration_country" nolabel="1"
                           placeholder="Immigration Country" class="o_field_highlight w-100 mb-0"/>
                </div>
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-id-card" title="Visa Program"/>
                    <field name="partner_visa_program_id" nolabel="1"
                           placeholder="Visa Program" class="o_field_highlight w-100 mb-0"
                           options="{'no_create': True}"/>
                </div>
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-comments" title="Communication Channel"/>
                    <field name="partner_communication_channel_id" nolabel="1"
                           placeholder="Communication Channel" class="o_field_highlight w-100 mb-0"
                           options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ── Kanban card override ──────────────────────────────────────────── -->
    <record id="jhm_crm_kanban_view" model="ir.ui.view">
        <field name="name">crm.lead.kanban.jhm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Load extra fields needed on the card -->
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="partner_immigration_country"/>
                <field name="partner_visa_program_id"/>
                <field name="partner_communication_channel_id"/>
                <field name="phone"/>
            </xpath>

            <!-- Hide expected revenue block -->
            <xpath expr="//t[@t-name='card']//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="attributes">
                <attribute name="t-if">false</attribute>
            </xpath>

            <!-- Replace contact line (partner_id + contact_name + partner_name) with our version -->
            <xpath expr="//t[@t-name='card']/div[hasclass('d-flex')][field[@name='partner_id']]" position="replace">
                <!-- Contact with avatar -->
                <div class="d-flex" invisible="not partner_id">
                    <field name="partner_id" widget="many2one_avatar" class="text-truncate" readonly="1" options="{'no_create': 1, 'no_open': 1}"/>
                    <field name="partner_id" class="ms-2 text-truncate"/>
                </div>
                <field name="contact_name" invisible="partner_id"/>
                <!-- Phone -->
                <div t-if="record.phone.raw_value" class="d-flex align-items-center gap-1">
                    <i class="fa fa-phone text-muted"/>
                    <field name="phone" class="text-truncate"/>
                </div>
                <!-- Immigration Country -->
                <div t-if="record.partner_immigration_country.raw_value" class="d-flex align-items-center gap-1">
                    <i class="fa fa-globe text-muted"/>
                    <field name="partner_immigration_country" class="text-truncate"/>
                </div>
                <!-- Visa Program -->
                <div t-if="record.partner_visa_program_id.raw_value" class="d-flex align-items-center gap-1">
                    <i class="fa fa-id-card text-muted"/>
                    <field name="partner_visa_program_id" class="text-truncate"/>
                </div>
                <!-- Communication Channel -->
                <div t-if="record.partner_communication_channel_id.raw_value" class="d-flex align-items-center gap-1">
                    <i class="fa fa-comments text-muted"/>
                    <field name="partner_communication_channel_id" class="text-truncate"/>
                </div>
            </xpath>

            <!-- Remove standalone contact_name and partner_name fallback lines (now included above) -->
            <xpath expr="//t[@t-name='card']/field[@name='contact_name']" position="replace"/>
            <xpath expr="//t[@t-name='card']/field[@name='partner_name']" position="replace"/>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         CRM Search — add phone search (Main Applicant + Spouse)
         ══════════════════════════════════════════════════════════════════════ -->

    <record id="jhm_crm_search_phone" model="ir.ui.view">
        <field name="name">crm.lead.search.jhm.phone</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone_mobile_search']" position="after">
                <field name="partner_spouse_phone" string="All Phones"
                       filter_domain="['|', ('phone', 'ilike', self), ('partner_spouse_phone', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         CRM Stage — list / form views with company_id + menu entry
         ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_crm_stage_list_jhm" model="ir.ui.view">
        <field name="name">crm.stage.list.jhm</field>
        <field name="model">crm.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="is_won"/>
            </list>
        </field>
    </record>

    <record id="view_crm_stage_form_jhm" model="ir.ui.view">
        <field name="name">crm.stage.form.jhm</field>
        <field name="model">crm.stage</field>
        <field name="arch" type="xml">
            <form string="Pipeline Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="team_ids" widget="many2many_tags"/>
                        <field name="company_id"/>
                        <field name="is_won"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_stage_jhm" model="ir.actions.act_window">
        <field name="name">Pipeline Stages</field>
        <field name="res_model">crm.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_crm_stage_jhm"
              name="Pipeline Stages"
              parent="crm.crm_menu_config"
              action="action_crm_stage_jhm"
              sequence="10"
              groups="base.group_system"/>

    <!-- ── Visa Programs management ──────────────────────────────────── -->
    <record id="view_visa_program_list" model="ir.ui.view">
        <field name="name">jhm.visa.program.list</field>
        <field name="model">jhm.visa.program</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_visa_program" model="ir.actions.act_window">
        <field name="name">Visa Programs</field>
        <field name="res_model">jhm.visa.program</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_visa_program"
              name="Visa Programs"
              parent="crm.crm_menu_config"
              action="action_visa_program"
              sequence="11"/>

    <!-- Remove default "My Pipeline" filter from CRM pipeline action -->
    <record model="ir.actions.act_window" id="crm.crm_lead_action_pipeline">
        <field name="context">{
                'default_type': 'opportunity',
        }</field>
    </record>

</odoo>
