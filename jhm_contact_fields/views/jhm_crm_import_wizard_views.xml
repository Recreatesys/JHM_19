<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Child file list view (inline in wizard) -->
        <record id="view_jhm_crm_import_file_list" model="ir.ui.view">
            <field name="name">jhm.crm.import.file.list</field>
            <field name="model">jhm.crm.import.file</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="file_data" filename="file_name" widget="binary" string="File"/>
                    <field name="file_name" string="File Name"/>
                    <field name="state" readonly="1" optional="show"/>
                    <field name="imported_count" readonly="1" optional="show"/>
                    <field name="skipped_count"  readonly="1" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Wizard form view -->
        <record id="view_jhm_crm_import_wizard_form" model="ir.ui.view">
            <field name="name">jhm.crm.import.wizard.form</field>
            <field name="model">jhm.crm.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import CRM Leads from XLS">
                    <sheet>

                        <!-- Format + mode — shown in draft only -->
                        <group col="2" invisible="state != 'draft'">
                            <field name="import_format" widget="radio"/>
                            <field name="import_mode"   widget="radio"/>
                        </group>

                        <!-- File list — shown in draft only -->
                        <group invisible="state != 'draft'">
                            <field name="file_ids"
                                   nolabel="1"
                                   mode="list"
                                   context="{'default_wizard_id': active_id}"/>
                        </group>

                        <!-- In-progress notice (shown if user closes dialog mid-import) -->
                        <group invisible="state != 'running'">
                            <div class="alert alert-info" role="status">
                                <strong>Import in progress.</strong>
                                File <field name="current_file_index" readonly="1" nolabel="1"
                                            style="display:inline; width:30px;"/> of
                                <field name="total_files" readonly="1" nolabel="1"
                                       style="display:inline; width:30px;"/>
                                &amp;nbsp;—&amp;nbsp;
                                Batch <field name="current_batch" readonly="1" nolabel="1"
                                             style="display:inline; width:40px;"/> of
                                <field name="total_batches" readonly="1" nolabel="1"
                                       style="display:inline; width:40px;"/>
                            </div>
                        </group>

                        <!-- Result section — shown after import completes -->
                        <group string="Import Result" invisible="state != 'done'">
                            <field name="grand_imported" string="Total Records Imported"/>
                            <field name="grand_skipped"  string="Total Records Skipped / Errors"/>
                        </group>

                        <!-- Per-file results table -->
                        <group invisible="state != 'done'">
                            <field name="file_ids" nolabel="1" mode="list" readonly="1">
                                <list>
                                    <field name="file_name"      string="File"/>
                                    <field name="state"          string="Status"/>
                                    <field name="imported_count" string="Imported"/>
                                    <field name="skipped_count"  string="Skipped"/>
                                    <field name="result_log"     string="Log" optional="show"/>
                                </list>
                            </field>
                        </group>

                        <field name="state"          invisible="1"/>
                        <field name="current_file_index" invisible="1"/>
                        <field name="total_files"    invisible="1"/>

                    </sheet>

                    <footer>
                        <!-- Draft: start import -->
                        <button name="action_import"
                                string="Start Import"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <!-- Running: resume (re-opens progress dialog) -->
                        <button name="action_import"
                                string="Resume Import"
                                type="object"
                                class="btn-warning"
                                invisible="state != 'running'"/>

                        <button string="Close"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Menu action -->
        <record id="action_jhm_crm_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Leads from XLS</field>
            <field name="res_model">jhm.crm.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- CRM menu entry -->
        <menuitem id="menu_jhm_crm_import_wizard"
                  name="Import Leads from XLS"
                  parent="crm.crm_menu_root"
                  action="action_jhm_crm_import_wizard"
                  sequence="99"
                  groups="sales_team.group_sale_manager"/>

    </data>
</odoo>
