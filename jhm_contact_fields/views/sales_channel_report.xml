<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         SALES REPORT BY CHANNEL
         Rows: Industry | Cols: Lead Source (ALL, even zero)
         Measure: Invoiced Amount  +  row subtotal (built-in Total column)
         Location: Sales → Reporting
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_sales_channel_search" model="ir.ui.view">
        <field name="name">jhm.sales.channel.line.search</field>
        <field name="model">jhm.sales.channel.line</field>
        <field name="arch" type="xml">
            <search string="Sales Report by Channel">
                <field name="industry_id"    string="Industry"/>
                <field name="lead_source_id" string="Lead Source"/>
                <separator/>
                <filter string="Has Revenue" name="has_revenue"
                        domain="[('invoiced_amount', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="view_sales_channel_pivot" model="ir.ui.view">
        <field name="name">jhm.sales.channel.line.pivot</field>
        <field name="model">jhm.sales.channel.line</field>
        <field name="arch" type="xml">
            <!-- Y-axis: Industry | X-axis: Lead Source | Total column = row subtotal -->
            <pivot string="Sales Report by Channel" disable_linking="True">
                <field name="industry_id"     type="row"/>
                <field name="lead_source_id"  type="col"/>
                <field name="invoiced_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sales_channel_report" model="ir.actions.act_window">
        <field name="name">Sales Report by Channel</field>
        <field name="res_model">jhm.sales.channel.line</field>
        <field name="view_mode">pivot</field>
        <field name="target">current</field>
        <field name="search_view_id" ref="view_sales_channel_search"/>
    </record>

    <menuitem
        id="menu_sales_channel_report"
        name="Sales Report by Channel"
        parent="sale.menu_sale_report"
        action="action_sales_channel_report"
        sequence="20"/>

</odoo>
