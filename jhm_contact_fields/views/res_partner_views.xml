<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Server action: batch create document folders for contacts ── -->
    <record id="action_partner_create_document_folders" model="ir.actions.server">
        <field name="name">Create Document Folders</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_create_document_folders()</field>
    </record>

    <record id="view_partner_form_jhm_fields" model="ir.ui.view">
        <field name="name">res.partner.form.jhm.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Spouse-of banner: shown only on spouse contacts -->
            <xpath expr="//notebook" position="before">
                <div class="alert alert-info" invisible="not spouse_of_id" style="margin-bottom:8px;">
                    <strong>Spouse of: </strong>
                    <field name="spouse_of_id" readonly="1" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>

            <!-- Insert JHM fields in the main sheet area, before the notebook -->
            <xpath expr="//notebook" position="before">

                <group string="JHM Information">
                    <group string="Profile">
                        <field name="occupation"/>
                        <field name="gender"/>
                        <field name="client_nationality_id"/>
                        <field name="jhm_line_id" string="Line ID"/>
                        <field name="communication_channel_id"/>
                        <field name="b2b_engagement"/>
                        <field name="background_id"/>
                        <field name="immigration_country"/>
                    </group>
                    <group string="Case">
                        <field name="visa_program_id"/>
                        <field name="previous_visa_program_id"/>
                        <field name="jhm_lead_source_id" string="Lead Source"/>
                        <field name="source_details"/>
                    </group>
                </group>

                <group>
                    <group string="Financial">
                        <field name="commission"/>
                        <field name="migration_budget"/>
                        <field name="facing_problems"/>
                        <field name="consultation_fee_paid"/>
                    </group>
                    <group string="Dates">
                        <field name="sf_creation_date"/>
                        <field name="appointment_date"/>
                        <field name="appointment_notes"/>
                        <field name="last_call_date"/>
                        <field name="sf_followup_date"/>
                    </group>
                </group>

                <group>
                    <group string="Personal">
                        <field name="birthday"/>
                    </group>
                </group>

                <group string="Case Tracking">
                    <group>
                        <field name="nomination"/>
                        <field name="nomination_due_date"/>
                        <field name="eoi"/>
                        <field name="eoi_date"/>
                        <field name="los_date"/>
                        <field name="lodgment_date"/>
                        <field name="ielts"/>
                        <field name="ielts_due_date"/>
                        <field name="aus_skill_status"/>
                        <field name="assessment"/>
                        <field name="assessment_due_date"/>
                    </group>
                    <group>
                        <field name="health"/>
                        <field name="health_due_date"/>
                        <field name="police"/>
                        <field name="police_due_date"/>
                    </group>
                </group>

                <separator string="Admin"/>
                <field name="admin" nolabel="1" placeholder="Admin notes..."
                       style="font-family:monospace; white-space:pre-wrap;"/>

                <separator string="Chat Log"/>
                <field name="chat_log" nolabel="1" placeholder="Chat log..."/>

                <separator string="Description"/>
                <field name="jhm_description" nolabel="1" placeholder="Description..."/>

            </xpath>

            <!-- Add JHM tabs to the notebook -->
            <xpath expr="//notebook" position="inside">

                <page string="Academic" name="jhm_academic">
                    <group>
                        <group>
                            <field name="academic_survey_date"/>
                            <field name="academic_problems"/>
                        </group>
                        <group>
                            <field name="academic_studied_in_immigration_country"/>
                            <field name="academic_highest_qualification"/>
                        </group>
                    </group>
                </page>

                <page string="Client Survey" name="jhm_client_survey">
                    <group>
                        <group>
                            <field name="survey_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="survey_problems"/>
                            <field name="survey_satisfaction"/>
                            <field name="survey_professional"/>
                        </group>
                        <group>
                            <field name="survey_responsive"/>
                            <field name="survey_recommend"/>
                        </group>
                    </group>
                </page>

                <page string="Spouse &amp; Children" name="jhm_spouse_children">
                    <group>
                        <group string="Spouse">
                            <field name="spouse_name"/>
                            <field name="spouse_phone" string="Spouse Mobile"/>
                            <field name="spouse_email"/>
                            <field name="spouse_highest_qualification"/>
                            <field name="spouse_occupation"/>
                            <field name="family_sponsorship"/>
                            <field name="spouse_studied_in_immigration_country"/>
                        </group>
                        <group string="Children">
                            <field name="no_of_children"/>
                            <field name="child_1"/>
                            <field name="child_2"/>
                            <field name="child_3"/>
                            <field name="child_4"/>
                            <field name="child_5"/>
                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
