<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Schedule Payment button on Sale Order form -->
    <record id="view_sale_order_form_jhm_schedule_payment" model="ir.ui.view">
        <field name="name">sale.order.form.jhm.schedule.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_schedule_payment" type="object"
                        string="Schedule Payment"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="state != 'sale'"/>
                <button name="action_view_draft_invoices" type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="draft_invoice_count == 0">
                    <field name="draft_invoice_count" widget="statinfo" string="Draft Invoices"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Schedule Payment button on task form -->
    <record id="view_task_form_jhm_schedule_payment" model="ir.ui.view">
        <field name="name">project.task.form.jhm.schedule.payment</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_schedule_payment" type="object"
                        string="Schedule Payment"
                        class="oe_stat_button"
                        icon="fa-money"/>
            </xpath>
        </field>
    </record>

    <!-- Payment Status on project form -->
    <record id="view_project_form_jhm_payment_status" model="ir.ui.view">
        <field name="name">project.project.form.jhm.payment.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" icon="fa-credit-card" type="object"
                        name="action_view_all_invoices" invisible="not sale_order_id">
                    <field name="payment_status" widget="badge"
                           decoration-danger="payment_status == 'Not Paid'"
                           decoration-warning="payment_status == 'Partially Paid'"
                           decoration-success="payment_status == 'Paid'"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Schedule Payment Wizard form -->
    <record id="view_jhm_schedule_payment_wizard_form" model="ir.ui.view">
        <field name="name">jhm.schedule.payment.wizard.form</field>
        <field name="model">jhm.schedule.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Payment">
                <group>
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="total_amount" readonly="1"/>
                        <field name="invoiced_amount" readonly="1"/>
                        <field name="balance" readonly="1"
                               decoration-danger="balance &lt; 0"
                               decoration-success="balance == 0"/>
                    </group>
                </group>
                <separator string="Payment Schedule"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="label" readonly="1"/>
                        <field name="amount"/>
                        <field name="invoice_date"/>
                        <field name="due_date"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Invoices" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
