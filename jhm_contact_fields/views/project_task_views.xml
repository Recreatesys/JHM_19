<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Schedule Payment button on Sale Order form -->
    <record id="view_sale_order_form_jhm_schedule_payment" model="ir.ui.view">
        <field name="name">sale.order.form.jhm.schedule.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="jhm_invoice_company_id" invisible="1"/>
                <button name="action_schedule_payment" type="object"
                        string="Schedule Payment"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="state != 'sale'"/>
                <button name="action_view_draft_invoices" type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="draft_invoice_count == 0">
                    <field name="draft_invoice_count" widget="statinfo" string="Draft Invoices"/>
                </button>
                <button name="action_view_jhm_invoices" type="object"
                        class="oe_stat_button"
                        icon="fa-file-text"
                        invisible="jhm_invoice_count == 0">
                    <field name="jhm_invoice_count" widget="statinfo" string="Invoice-JHM"/>
                </button>
            </xpath>
            <!-- Invoice in JHM / JHML choice buttons -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="jhm_invoice_company_id" string="Invoice Company" readonly="jhm_invoice_company_id"
                       invisible="company_id != 1 or state != 'sale'"
                       domain="[('id', 'in', [1, 4])]"
                       help="Once set to JHM, all invoices will be created in JHM company."/>
                <button name="action_set_invoice_in_jhm" type="object"
                        string="⚡ Invoice in JHM" class="btn-primary"
                        invisible="company_id != 1 or state != 'sale' or jhm_invoice_company_id"/>
                <button name="action_set_invoice_in_jhml" type="object"
                        string="Reset to JHML" class="btn-secondary"
                        invisible="company_id != 1 or state != 'sale' or not jhm_invoice_company_id"/>
            </xpath>
        </field>
    </record>

    <!-- Task form: Schedule Payment + Ownership/Co-ownership fields -->
    <record id="view_task_form_jhm_schedule_payment" model="ir.ui.view">
        <field name="name">project.task.form.jhm.schedule.payment</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_schedule_payment" type="object"
                        string="Schedule Payment"
                        class="oe_stat_button"
                        icon="fa-money"/>
            </xpath>
            <!-- Add Ownership and Co-ownership after user_ids -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="ownership_ids" widget="many2many_tags" string="Ownership"
                       options="{'no_create': True}"/>
                <field name="co_ownership_ids" widget="many2many_tags" string="Co-ownership"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Project form: Ownership/Co-ownership fields -->
    <record id="view_project_form_jhm_ownership" model="ir.ui.view">
        <field name="name">project.project.form.jhm.ownership</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ownership_ids" widget="many2many_tags" string="Ownership"
                       options="{'no_create': True}"/>
                <field name="co_ownership_ids" widget="many2many_tags" string="Co-ownership"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Payment Status on project form -->
    <record id="view_project_form_jhm_payment_status" model="ir.ui.view">
        <field name="name">project.project.form.jhm.payment.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" icon="fa-credit-card" type="object"
                        name="action_view_all_invoices" invisible="not sale_order_id">
                    <field name="payment_status" widget="badge"
                           decoration-danger="payment_status == 'Not Paid'"
                           decoration-warning="payment_status == 'Partially Paid'"
                           decoration-success="payment_status == 'Paid'"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Payment Status badge on project kanban card -->
    <record id="view_project_kanban_jhm_payment" model="ir.ui.view">
        <field name="name">project.project.kanban.jhm.payment</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="payment_status" invisible="not payment_status"
                       widget="badge"
                       decoration-danger="payment_status == 'Not Paid'"
                       decoration-warning="payment_status == 'Partially Paid'"
                       decoration-success="payment_status == 'Paid'"/>
            </xpath>
        </field>
    </record>

    <!-- Payment Status badge on task kanban card -->
    <record id="view_task_kanban_jhm_payment" model="ir.ui.view">
        <field name="name">project.task.kanban.jhm.payment</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="payment_status" invisible="not payment_status"
                       widget="badge"
                       decoration-danger="payment_status == 'Not Paid'"
                       decoration-warning="payment_status == 'Partially Paid'"
                       decoration-success="payment_status == 'Paid'"/>
            </xpath>
        </field>
    </record>

    <!-- Schedule Payment Wizard form -->
    <record id="view_jhm_schedule_payment_wizard_form" model="ir.ui.view">
        <field name="name">jhm.schedule.payment.wizard.form</field>
        <field name="model">jhm.schedule.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Payment">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="total_amount" readonly="1"/>
                        <field name="invoiced_amount" readonly="1"/>
                        <field name="balance" readonly="1"
                               decoration-danger="balance &lt; 0"
                               decoration-success="balance == 0"/>
                    </group>
                </group>
                <separator string="Existing Invoices" invisible="not existing_invoice_ids"/>
                <field name="existing_invoice_ids" nolabel="1" readonly="1"
                       invisible="not existing_invoice_ids">
                    <list>
                        <field name="label"/>
                        <field name="amount"/>
                        <field name="invoice_date"/>
                        <field name="due_date"/>
                        <field name="payment_state" widget="badge"
                               decoration-danger="payment_state == 'not_paid'"
                               decoration-warning="payment_state == 'partial'"
                               decoration-success="payment_state == 'paid'"
                               decoration-info="payment_state == 'in_payment'"/>
                        <button name="action_open_invoice" type="object"
                                string="Go to Invoice" icon="fa-external-link"
                                class="btn-link"/>
                    </list>
                </field>
                <separator string="New Payments" invisible="state == 'done'"/>
                <field name="line_ids" nolabel="1" invisible="state == 'done'">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="label" readonly="1"/>
                        <field name="amount"/>
                        <field name="invoice_date"/>
                        <field name="due_date"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Invoices" name="action_confirm" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" special="cancel" invisible="state != 'done'"/>
                    <button string="Cancel" special="cancel" invisible="state == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
