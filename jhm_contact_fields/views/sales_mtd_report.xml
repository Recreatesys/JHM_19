<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ──────────────────────────────────────────────────────── -->
    <record id="view_jhm_sales_mtd_search" model="ir.ui.view">
        <field name="name">jhm.sales.mtd.line.search</field>
        <field name="model">jhm.sales.mtd.line</field>
        <field name="arch" type="xml">
            <search string="Sales Report (MTD)">
                <field name="user_id"  string="Salesperson"/>
                <field name="period"   string="Period"/>
            </search>
        </field>
    </record>

    <!-- ── Pivot ───────────────────────────────────────────────────────── -->
    <record id="view_jhm_sales_mtd_pivot" model="ir.ui.view">
        <field name="name">jhm.sales.mtd.line.pivot</field>
        <field name="model">jhm.sales.mtd.line</field>
        <field name="arch" type="xml">
            <pivot string="Sales Report (MTD)" disable_linking="True">
                <field name="user_id"           type="row"/>
                <field name="period"            type="col"/>
                <field name="new_leads"         type="measure"/>
                <field name="qualified_leads"   type="measure"/>
                <field name="qualified_pct"     type="measure"/>
                <field name="appointments"      type="measure"/>
                <field name="appointment_pct"   type="measure"/>
                <field name="sales_count"       type="measure"/>
                <field name="sales_pct"         type="measure"/>
                <field name="sales_amount"      type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ── List fallback ───────────────────────────────────────────────── -->
    <record id="view_jhm_sales_mtd_list" model="ir.ui.view">
        <field name="name">jhm.sales.mtd.line.list</field>
        <field name="model">jhm.sales.mtd.line</field>
        <field name="arch" type="xml">
            <list string="Sales Report (MTD)" create="false" edit="false" delete="false">
                <field name="period"            string="Period"/>
                <field name="user_id"           string="Salesperson"/>
                <field name="new_leads"         string="New Leads"/>
                <field name="qualified_leads"   string="Qualified Leads"/>
                <field name="qualified_pct"     string="% Qualified"/>
                <field name="appointments"      string="Appointment"/>
                <field name="appointment_pct"   string="% Appointment"/>
                <field name="sales_count"       string="Sales #"/>
                <field name="sales_pct"         string="% Sales"/>
                <field name="sales_amount"      string="Sales $"/>
            </list>
        </field>
    </record>

    <!-- ── Window action ───────────────────────────────────────────────── -->
    <record id="action_jhm_sales_mtd_report" model="ir.actions.act_window">
        <field name="name">Sales Report (MTD)</field>
        <field name="res_model">jhm.sales.mtd.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="target">current</field>
        <field name="search_view_id" ref="view_jhm_sales_mtd_search"/>
        <field name="context">{}</field>
    </record>

    <!-- ── CRM Reporting menu ──────────────────────────────────────────── -->
    <menuitem
        id="menu_jhm_sales_mtd_report"
        name="Sales Report (MTD)"
        parent="crm.crm_menu_report"
        action="action_jhm_sales_mtd_report"
        sequence="26"/>

</odoo>
