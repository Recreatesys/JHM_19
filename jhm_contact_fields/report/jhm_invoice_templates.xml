    <!-- JHML Invoice -->
    <record id="action_report_jhml_invoice" model="ir.actions.report">
        <field name="name">JHML Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jhm_contact_fields.jhml_invoice_document</field>
        <field name="report_file">jhm_contact_fields.jhml_invoice_document</field>
        <field name="print_report_name">'JHML-IV-%s' % object.name</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

